DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support

# ---- AI 回复建议 ----
AI_SUGGEST_ENABLED=true
# claude：使用 Anthropic Claude；openai_compatible：使用公司自有模型网关（如售后数字人）
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# LLM_PROVIDER=openai_compatible 时填写：
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=true

# ---- 企业微信 会话内容存档 ----
WECOM_CORP_ID=
WECOM_ARCHIVE_SECRET=
# 消息加密私钥，按版本号映射到 PEM 文件路径
WECOM_ARCHIVE_PRIVATE_KEY_FILES={"1": "/opt/wecom/archive_v1.pem"}
WECOM_SDK_LIB_PATH=/opt/wecom/libWeWorkFinanceSdk_C.so
WECOM_ARCHIVE_POLL_INTERVAL=30
# 存档应用「接收事件服务器」，回调地址填 https://<你的域名>/webhooks/wecom
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
# 可选：「客户联系」Secret，用于显示外部客户群名称
WECOM_CONTACT_SECRET=
