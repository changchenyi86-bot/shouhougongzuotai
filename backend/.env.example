DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support

# ---- AI 回复建议 ----
AI_SUGGEST_ENABLED=true
# claude：使用 Anthropic Claude；openai_compatible：使用公司自有模型网关（如售后数字人）
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# LLM_PROVIDER=openai_compatible 时填写：
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=true

# ---- 售后数字人知识检索 ----
# 生成回复建议前到售后数字人（自建实例，不接生产）的检索服务查参考知识；留空表示不查。
# 服务只在内网时经本机 SSH 隧道访问，容器里用 host.docker.internal:<本机端口>
KNOWLEDGE_MCP_URL=
KNOWLEDGE_PRODUCT=bi
KNOWLEDGE_TOP=6

# ---- 知识库向量检索（embedding） ----
# OpenAI 兼容的 /v1/embeddings 接口。内网服务经本机 SSH 隧道访问时，容器里用 host.docker.internal:<本机端口>
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# ---- 企业微信 会话内容存档 ----
WECOM_CORP_ID=
WECOM_ARCHIVE_SECRET=
# 消息加密私钥，按公钥版本号映射到 PEM 文件路径（文件放在项目根目录 secrets/wecom/ 下）
WECOM_ARCHIVE_PRIVATE_KEY_FILES={"2": "/opt/wecom/archive_v2.pem"}
# 没有私钥、直接跳过的公钥版本（版本 1 的私钥只在七鱼手里）
WECOM_ARCHIVE_SKIP_KEY_VERSIONS=["1"]
WECOM_SDK_LIB_PATH=/opt/wecom/libWeWorkFinanceSdk_C.so
WECOM_ARCHIVE_POLL_INTERVAL=30
# 存档应用「接收事件服务器」，回调地址填 https://<你的域名>/webhooks/wecom
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
# 可选：「客户联系」Secret，用于显示外部客户群名称。没有单独的客户联系 Secret 时，
# 用「客户联系 → 客户 → API → 可调用接口的应用」里那个自建应用的 Secret
WECOM_CONTACT_SECRET=
# 可选：查外部群群名走的代理。本机出口 IP 加不进自建应用的企业可信 IP 时，
# 在本机开 ssh -N -D 127.0.0.1:18968 <有可信 IP 的服务器>，这里填 socks5://host.docker.internal:18968
WECOM_CONTACT_PROXY=

# ---- 自动发送（电脑端发送程序操作企业微信客户端，见 windows-agent/） ----
# 发送程序的访问口令，自己生成一个长随机串，同样填到发送电脑的 config.ini；留空表示不启用自动发送
SEND_AGENT_TOKEN=
SEND_MIN_INTERVAL_SECONDS=5
SEND_GROUP_MAX_PER_HOUR=20
SEND_QUEUE_TIMEOUT_MINUTES=10
SEND_RESULT_TIMEOUT_MINUTES=3

# ---- 附件（图片、文件） ----
ATTACHMENT_DIR=./data/attachments
ATTACHMENT_MAX_MB=20
